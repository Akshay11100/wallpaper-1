# Postgres. Use the POOLED connection string (Neon, Supabase or Vercel Postgres).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Shared secret that unlocks the procurement board. Generate a long random one:
#   openssl rand -hex 24
TEAM_KEY=

# Metabase. The API key needs read access to the warehouse only.
METABASE_URL=https://metabase.materialdepot.in
METABASE_API_KEY=
METABASE_DB_ID=5

# Only import orders placed on or after this date.
MB_SINCE=2026-08-20
